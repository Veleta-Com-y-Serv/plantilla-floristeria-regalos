---
// Preguntas frecuentes: banda crema con una onda arriba; titular a la izquierda (fijo al bajar en escritorio) y
// acordeón nativo <details> a la derecha, sin JavaScript, con el «+» dentro de un pétalo rosa.
// Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas, la sección no se pinta.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={Astro.props.id} banda="crema" onda={1}>
      <div class="faq-rejilla">
        <div class="faq-titular">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
        </div>
        <div class="faq-lista">
          {preguntas.map((p) => (
            <details class="faq">
              <summary>
                <span class="faq-pregunta">{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true">+</span>
              </summary>
              <p class="faq-respuesta">{p.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .faq-rejilla { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) {
    .faq-rejilla { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 5rem; align-items: start; }
    .faq-titular { position: sticky; top: 7rem; }
  }
  .faq-lista { border-top: 1px solid var(--linea); }
  .faq { border-bottom: 1px solid var(--linea); }
  .faq summary { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding-block: 1.35rem; min-height: 3rem; }
  .faq-pregunta { font-family: var(--fuente-titulos); font-style: italic; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.25; }
  .faq-signo { display: grid; place-items: center; flex: none; width: 2.6rem; height: 2.6rem; border-radius: var(--petalo-1); background: var(--polvo); color: var(--rosa-legible); font-size: 1.5rem; line-height: 1; transition: transform .2s ease; }
  .faq summary:hover .faq-signo { background: var(--c-acento); color: var(--c-sobre-acento); }
  .faq-respuesta { padding-bottom: 1.5rem; max-width: 46rem; opacity: .85; }
</style>
