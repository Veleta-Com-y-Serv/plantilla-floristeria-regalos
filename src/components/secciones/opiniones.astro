---
// Opiniones: banda verde hoja a todo el ancho con una onda arriba. La primera opinión como cita enorme en
// cursiva; las demás en columnas (hasta 3) separadas por filetes. Campos: `testimonios[]` (texto, autor) y `nota`
// opcional (de dónde salen). Sin testimonios, la sección no se pinta.
import { seccion, valor } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Mancha from '../ui/Mancha.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const testimonios = s ? s.testimonios.filter((t) => t && valor(t.texto)) : [];
const [primera, ...resto] = testimonios;
const nota = valor(s?.nota);
---

{
  s && testimonios.length > 0 && (
    <Seccion id={Astro.props.id} banda="hoja" onda={2}>
      <Mancha slot="deco" forma={2} class="opi-mancha" />
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <figure class="opi-grande">
        <span class="opi-comilla" aria-hidden="true">“</span>
        <blockquote>{primera.texto}</blockquote>
        {primera.autor && <figcaption>{primera.autor}</figcaption>}
      </figure>
      {resto.length > 0 && (
        <ul class:list={['opi-resto', resto.length >= 3 ? 'opi-resto--3' : 'opi-resto--2']}>
          {resto.map((t) => (
            <li>
              <figure>
                <blockquote class="opi-texto">“{t.texto}”</blockquote>
                {t.autor && <figcaption>{t.autor}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      )}
      {nota && <p class="opi-nota">{nota}</p>}
    </Seccion>
  )
}

<style>
  :global(.opi-mancha) { width: 36rem; right: -16rem; bottom: -12rem; color: color-mix(in srgb, var(--c-sobre-primario) 7%, transparent); }
  .opi-grande { position: relative; max-width: 68rem; }
  .opi-comilla { display: block; height: 4.5rem; font-family: var(--fuente-titulos); font-size: 9rem; line-height: 1; color: var(--c-acento); }
  .opi-grande blockquote { font-family: var(--fuente-titulos); font-style: italic; font-size: clamp(1.85rem, 4.2vw, 3.6rem); line-height: 1.15; letter-spacing: -.01em; }
  figcaption { margin-top: 1.25rem; font-size: .78rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--realce); }
  .opi-resto { margin-top: 4rem; display: grid; gap: 2.5rem; }
  @media (min-width: 768px) { .opi-resto { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; } }
  @media (min-width: 1100px) { .opi-resto--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .opi-resto li { padding-top: 1.75rem; border-top: 1px solid var(--linea); }
  .opi-texto { font-family: var(--fuente-titulos); font-style: italic; font-size: 1.35rem; line-height: 1.4; }
  .opi-nota { margin-top: 3.5rem; font-size: .9rem; opacity: .8; }
</style>
