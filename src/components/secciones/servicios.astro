---
// Servicios (eventos y bodas, suscripción, empresas, talleres…): partido a sangre. A la izquierda el titular y los
// servicios de `items` (titulo, texto, icono, precio «desde» opcional) en dos columnas con el icono en un pétalo;
// a la derecha la foto (`imagen`) hasta el borde de la ventana con el borde interior ondulado. `cta` opcional.
// Sin foto, los servicios ocupan todo el ancho en 4 columnas. Sin servicios ni texto, no se pinta.
import { seccion, valor } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import Onda from '../ui/Onda.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((it) => it && it.titulo) : [];
---

{
  s && (items.length > 0 || s.texto) && (
    <section id={Astro.props.id} class="banda banda--crema">
      <Onda forma={1} />
      <div class:list={['celdas', !s.imagen && 'serv--sola']}>
        <div class:list={['celda', s.imagen ? 'celda--izq' : 'contenedor']}>
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {items.length > 0 && (
            <ul class="serv-lista">
              {items.map((it) => {
                const precio = valor(it.precio);
                return (
                  <li>
                    <span class="serv-icono" aria-hidden="true"><Icono nombre={it.icono || 'flor'} tam={24} /></span>
                    <h3 class="serv-titulo">{it.titulo}</h3>
                    {it.texto && <p class="serv-texto">{it.texto}</p>}
                    {precio && <p class="serv-precio">{precio}</p>}
                  </li>
                );
              })}
            </ul>
          )}
          {s.cta?.url && <a class="btn mt-12" href={s.cta.url}>{s.cta.texto}</a>}
        </div>
        {s.imagen && (
          <div class="celda-foto serv-foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1500} />
            <svg class="serv-borde" viewBox="0 0 60 800" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d="M0 0H34C14 90 52 170 30 270S6 420 34 520 18 700 40 800H0Z" fill="currentColor" />
            </svg>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .serv-lista { display: grid; gap: 2.25rem; }
  @media (min-width: 640px) { .serv-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 2rem; } }
  .serv--sola { grid-template-columns: 1fr; }
  @media (min-width: 1100px) { .serv--sola .serv-lista { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .serv-lista li { padding-top: 1.5rem; border-top: 1px solid var(--linea); }
  .serv-icono { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: var(--petalo-1); background: var(--polvo); color: var(--rosa-legible); }
  .serv-titulo { margin-top: 1.1rem; font-size: clamp(1.5rem, 2.2vw, 1.9rem); }
  .serv-texto { margin-top: .6rem; opacity: .82; }
  .serv-precio { margin-top: .85rem; display: inline-block; padding: .2rem .8rem; border-radius: 1rem .25rem 1rem .25rem; background: var(--salvia); color: var(--hoja-legible); font-weight: 700; font-size: .9rem; }
  .serv-foto { min-height: 24rem; }
  @media (min-width: 768px) { .serv-foto { min-height: 100%; } }
  .serv-borde { display: none; }
  @media (min-width: 768px) {
    .serv-borde { display: block; position: absolute; left: -1px; top: 0; width: clamp(2rem, 4vw, 3.75rem); height: 100%; max-width: none; color: var(--banda); }
  }
</style>
