---
// Mancha orgánica decorativa (forma de pétalo), del color de texto actual (`currentColor`). Sin texto ni alt:
// va dentro de una capa `.deco` recortada para no crear scroll lateral. `contorno` la pinta solo con línea.
interface Props { forma?: 1 | 2 | 3; class?: string; contorno?: boolean }
const { forma = 1, class: clase = '', contorno = false } = Astro.props;
const caminos = {
  1: 'M143.7 41.4c12.2 9.3 20.7 23.4 25.4 38.9 4.7 15.5 5.5 32.4-.9 46.1-6.4 13.7-20 24.2-34.8 32.1-14.8 7.9-30.8 13.2-47.3 11.8-16.5-1.4-33.5-9.5-45-22.5C29.6 134.8 23.6 116.9 24.5 99.5c.9-17.4 8.7-34.3 21.2-44.1 12.5-9.8 29.7-12.5 45.9-13.5 16.2-1 39.9-9.8 52.1-.5z',
  2: 'M151.2 37.3c13.3 11.9 21.1 29.3 23.2 46.9 2.1 17.6-1.5 35.4-10.8 49.6-9.3 14.2-24.3 24.8-41.1 31.6-16.8 6.8-35.4 9.8-51.8 4.2-16.4-5.6-30.6-19.8-38.5-36.7C24.3 116 22.7 96.4 28.6 79.6 34.5 62.8 47.9 48.8 63 37.4c15.1-11.4 26-20.2 40.7-24.6 14.6-4.4 34.2 12.6 47.5 24.5z',
  3: 'M134.6 30.2c17.6 6.6 34.9 19.4 41.6 36.5 6.7 17.1 2.8 38.5-6.9 55.2-9.7 16.7-25.2 28.7-42.6 36.3-17.4 7.6-36.7 10.8-53 4.9-16.3-5.9-29.6-20.9-36.2-37.8-6.6-16.9-6.5-35.7.4-51.5 6.9-15.8 20.6-28.6 36-36.2 15.4-7.6 43.1-14 60.7-7.4z',
};
---

<svg class:list={['mancha', clase]} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <path d={caminos[forma]} fill={contorno ? 'none' : 'currentColor'} stroke={contorno ? 'currentColor' : 'none'} stroke-width={contorno ? 1.2 : 0} />
</svg>
