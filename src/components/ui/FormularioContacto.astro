---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto).
// Si no hay email, se queda como muestra y lo avisa. Para un envío real, cambia `action` por el de tu proveedor.
// `encargo`: añade ocasión (lista `ocasiones`), fecha de entrega, dirección de entrega y mensaje para la tarjeta,
// en una rejilla ancha (1 columna en móvil, 3 en escritorio).
import { site } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; prefijo?: string; encargo?: boolean; ocasiones?: string[] }
const { boton = 'Enviar mensaje', class: clase = '', asunto = `Consulta desde la web de ${site.nombre}`, prefijo = 'f', encargo = false, ocasiones = [] } = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
---

<form class:list={['formulario', { 'formulario--encargo': encargo }, clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="campo">
    <label for={`${prefijo}-nombre`}>Nombre</label>
    <input id={`${prefijo}-nombre`} name="nombre" type="text" autocomplete="name" required />
  </div>
  <div class="campo">
    <label for={`${prefijo}-contacto`}>Email o teléfono</label>
    <input id={`${prefijo}-contacto`} name="contacto" type="text" autocomplete="email" required />
  </div>
  {
    encargo && (
      <>
        <div class="campo">
          <label for={`${prefijo}-ocasion`}>Ocasión</label>
          <select id={`${prefijo}-ocasion`} name="ocasion">
            {ocasiones.map((o) => <option>{o}</option>)}
            <option>Otra</option>
          </select>
        </div>
        <div class="campo">
          <label for={`${prefijo}-fecha`}>Fecha de entrega</label>
          <input id={`${prefijo}-fecha`} name="fecha_entrega" type="date" required />
        </div>
        <div class="campo">
          <label for={`${prefijo}-entrega`}>Recogida o envío</label>
          <select id={`${prefijo}-entrega`} name="entrega">
            <option>Recojo en la tienda</option>
            <option>Envío a domicilio</option>
          </select>
        </div>
        <div class="campo">
          <label for={`${prefijo}-direccion`}>Dirección de entrega</label>
          <input id={`${prefijo}-direccion`} name="direccion_entrega" type="text" autocomplete="street-address" />
        </div>
        <div class="campo campo--ancho campo--medio">
          <label for={`${prefijo}-tarjeta`}>Mensaje para la tarjeta</label>
          <textarea id={`${prefijo}-tarjeta`} name="tarjeta" rows="3"></textarea>
        </div>
      </>
    )
  }
  <div class:list={['campo', { 'campo--ancho campo--medio': encargo }]}>
    <label for={`${prefijo}-mensaje`}>{encargo ? '¿Qué tienes en mente?' : 'Mensaje'}</label>
    <textarea id={`${prefijo}-mensaje`} name="mensaje" rows="4" required></textarea>
  </div>
  <label class="campo-check campo--ancho">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <div class="campo--ancho grid gap-3">
    <button type="submit" class="btn justify-self-start">{boton}</button>
    <p class="formulario-aviso">
      {
        email
          ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
          : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
      }
    </p>
  </div>
</form>

<style>
  @media (min-width: 768px) {
    .formulario--encargo { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.25rem; }
    .formulario--encargo .campo--ancho { grid-column: 1 / -1; }
  }
  @media (min-width: 1100px) {
    .formulario--encargo { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .formulario--encargo > .campo { grid-column: span 2; }
    .formulario--encargo > .campo--medio { grid-column: span 3; }
  }
</style>
