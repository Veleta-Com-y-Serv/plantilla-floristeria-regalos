---
// Ejemplo de página adicional: usa el layout base y se enlaza desde el pie (o desde site.yaml → menu).
import Base from '../layouts/Base.astro';
import Onda from '../components/ui/Onda.astro';
import { site } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda banda--rosa">
    <div class="contenedor pb-16 pt-16 md:pb-24 md:pt-24">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="titulo-seccion">Aviso legal y privacidad</h1>
    </div>
  </section>
  <section class="banda banda--crema">
    <Onda forma={1} />
    <article class="contenedor texto-largo max-w-3xl pb-20 pt-10 md:pb-28">
      <h2>Quiénes somos</h2>
      <p>
        Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
          c.email || 'nuestro correo de contacto'
        }{c.telefono && ` o llamarnos al ${c.telefono}`}.
      </p>
      <h2>Qué datos tratamos</h2>
      <p>
        Solo los que nos envías al escribirnos o hacer un encargo: nombre, forma de contacto, tu mensaje y, si nos
        pides un envío, la dirección y el nombre de quien lo recibe. Los usamos para responderte y entregar el pedido.
        No los cedemos a nadie salvo obligación legal.
      </p>
      <h2>Cuánto tiempo los guardamos</h2>
      <p>El necesario para atender tu consulta o tu encargo y, después, el que marque la ley.</p>
      <h2>Tus derechos</h2>
      <p>
        Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
        puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
      </p>
      <h2>Cookies</h2>
      <p>Esta web no usa cookies de seguimiento.</p>
      <p class="mt-12"><a class="btn" href="/">Volver al inicio</a></p>
    </article>
  </section>
</Base>
